<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Secuencia correlativa para facturas. -->
        <record id="seq_caryvil_invoice" model="ir.sequence">
            <field name="name">Factura Caryvil</field>
            <field name="code">caryvil.simple.invoice.sequence</field>
            <field name="prefix">FAC-%(year)s-</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="implementation">no_gap</field>
            <field name="company_id" ref="caryvil_erp.company_farmacia_caryvil"/>
        </record>

    </data>
</odoo>