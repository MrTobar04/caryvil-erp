<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="caryvil_erp.PurchaseLiveTotals">
        <div class="o_caryvil_purchase_totals" style="min-width: 300px;">
            <div class="d-flex justify-content-between py-1">
                <span>Subtotal:</span>
                <strong t-esc="fmt(net)"/>
            </div>
            <div class="d-flex justify-content-between py-1">
                <span>Descuento:</span>
                <strong t-esc="fmt(discount)"/>
            </div>
            <div class="d-flex justify-content-between py-1">
                <span>IVA (13%):</span>
                <strong t-esc="fmt(iva)"/>
            </div>
            <div class="d-flex justify-content-between align-items-center py-1">
                <span>IVA Percibido (1%):</span>
                <span>
                    <input type="checkbox" class="me-2" t-att-checked="ivaPercibidoCheck" t-on-change="onToggleIvaPercibido"/>
                    <strong t-esc="fmt(ivaPercibido)"/>
                </span>
            </div>
            <hr class="my-1"/>
            <div class="d-flex justify-content-between py-1">
                <strong>Total:</strong>
                <strong t-esc="fmt(total)"/>
            </div>
        </div>
    </t>
</templates>
