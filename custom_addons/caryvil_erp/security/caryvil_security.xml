<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Categoría de Módulo para Grupos de Seguridad -->
        <record id="module_category_caryvil_erp" model="ir.module.category">
            <field name="name">Farmacia Caryvil ERP</field>
            <field name="description">Niveles de acceso y roles para la gestión de Farmacia Caryvil</field>
            <field name="sequence">20</field>
        </record>

        <!-- Rol: Cajero / Mostrador -->
        <record id="group_caryvil_cajero" model="res.groups">
            <field name="name">Cajero / Mostrador</field>
            <field name="category_id" ref="module_category_caryvil_erp"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Rol: Farmacéutico / Dependiente -->
        <record id="group_caryvil_farmaceutico" model="res.groups">
            <field name="name">Farmacéutico / Dependiente</field>
            <field name="category_id" ref="module_category_caryvil_erp"/>
            <field name="implied_ids" eval="[(4, ref('group_caryvil_cajero'))]"/>
        </record>

        <!-- Rol: Encargado de Compras e Inventario -->
        <!-- Incluye el grupo nativo "Facturación" (account.group_account_invoice) porque Odoo   -->
        <!-- exige ese grupo específico (a nivel de código, no solo de ir.model.access) para      -->
        <!-- poder confirmar Facturas de Proveedor y registrar Pagos/abonos (SPEC-8.1.2). Sin él,  -->
        <!-- el Encargado de Compras podría crear la factura pero no confirmarla ni cobrarla.      -->
        <record id="group_caryvil_compras_inventario" model="res.groups">
            <field name="name">Encargado de Compras e Inventario</field>
            <field name="category_id" ref="module_category_caryvil_erp"/>
            <field name="implied_ids" eval="[(4, ref('group_caryvil_farmaceutico')), (4, ref('account.group_account_invoice'))]"/>
        </record>

        <!-- Rol: Administrador General -->
        <record id="group_caryvil_admin" model="res.groups">
            <field name="name">Administrador General</field>
            <field name="category_id" ref="module_category_caryvil_erp"/>
            <field name="implied_ids" eval="[(4, ref('group_caryvil_compras_inventario')), (4, ref('base.group_system'))]"/>
        </record>
    </data>
</odoo>
