<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchase_order_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
                    <div class="page">
                        <style>
                            .caryvil-po-table thead th {
                                background-color: #004085;
                                color: #ffffff;
                                font-size: 11px;
                                text-transform: uppercase;
                            }
                            .caryvil-po-table tbody tr:nth-child(even) {
                                background-color: #f2f5f9;
                            }
                            .caryvil-po-table td, .caryvil-po-table th {
                                padding: 6px 8px;
                                word-break: break-word;
                            }
                            .caryvil-signature-box {
                                border-top: 1px solid #333;
                                margin-top: 40px;
                                padding-top: 4px;
                                text-align: center;
                            }
                        </style>

                        <div class="mt-2 mb-4">
                            <h2>
                                <span t-if="o.state in ('draft', 'sent')">Solicitud de Presupuesto</span>
                                <span t-elif="o.state == 'cancel'">Orden de Compra Cancelada</span>
                                <span t-else="">Orden de Compra</span>
                                #<span t-field="o.name"/>
                            </h2>
                            <p>
                                <strong>Fecha de Emisión:</strong>
                                <span t-field="o.date_order" t-options='{"widget": "date"}'/>
                            </p>
                        </div>

                        <div class="row mb-4">
                            <div class="col-6">
                                <strong>Proveedor</strong>
                                <p class="m-0" t-field="o.laboratory_id.name"/>
                                <p class="m-0" t-if="o.laboratory_id.nit">
                                    NIT: <span t-field="o.laboratory_id.nit"/>
                                </p>
                                <p class="m-0" t-if="o.laboratory_id.nrc">
                                    NRC: <span t-field="o.laboratory_id.nrc"/>
                                </p>
                                <p class="m-0" t-if="o.laboratory_id.street">
                                    <span t-field="o.laboratory_id.street"/>
                                </p>
                                <p class="m-0">
                                    <strong>Vendedor:</strong> <span t-field="o.partner_id.name"/>
                                </p>
                                <p class="m-0" t-if="o.partner_id.phone">
                                    Tel: <span t-field="o.partner_id.phone"/>
                                </p>
                                <p class="m-0" t-if="o.partner_id.email">
                                    Correo: <span t-field="o.partner_id.email"/>
                                </p>
                            </div>
                            <div class="col-6">
                                <strong>Condiciones</strong>
                                <p class="m-0">
                                    <strong>Condiciones de Pago:</strong>
                                    <span t-field="o.commercial_terms_id"/>
                                </p>
                            </div>
                        </div>

                        <table class="table table-sm caryvil-po-table">
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Producto / Descripción</th>
                                    <th>Presentación</th>
                                    <th class="text-end">Cantidad</th>
                                    <th class="text-end">Precio Unitario</th>
                                    <th class="text-end">Descuento</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.order_line" t-as="line" t-if="not line.display_type">
                                    <td>
                                        <span t-field="line.product_id.default_code"/>
                                    </td>
                                    <td>
                                        <span t-field="line.product_id.name"/>
                                    </td>
                                    <td>
                                        <span t-field="line.product_uom.name"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.product_qty"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.price_unit"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.discount"/>%
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.price_subtotal"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="row justify-content-end">
                            <div class="col-5">
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td><strong>Subtotal</strong></td>
                                        <td class="text-end">
                                            <span t-field="o.amount_untaxed"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>Descuento</strong></td>
                                        <td class="text-end">
                                            <span t-field="o.amount_discount_total"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>IVA (13%)</strong></td>
                                        <td class="text-end">
                                            <span t-field="o.amount_tax"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr t-if="o.iva_percibido_check">
                                        <td><strong>IVA Percibido (1%)</strong></td>
                                        <td class="text-end">
                                            <span t-field="o.amount_iva_percibido"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr style="border-top: 2px solid #004085;">
                                        <td><strong>Total</strong></td>
                                        <td class="text-end">
                                            <strong>
                                                <span t-field="o.amount_total_final"
                                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </strong>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div class="mt-4" t-if="o.notes_reception">
                            <strong>Instrucciones de Recepción</strong>
                            <p t-field="o.notes_reception"/>
                        </div>

                        <div class="row mt-5">
                            <div class="col-6">
                                <div class="caryvil-signature-box">Elaborado por</div>
                            </div>
                            <div class="col-6">
                                <div class="caryvil-signature-box">Autorizado por</div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
