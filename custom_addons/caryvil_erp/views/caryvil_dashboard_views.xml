<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ================================================================ -->
        <!-- Acción de Cliente OWL para el Dashboard de Ventas Caryvil        -->
        <!-- ================================================================ -->
        <record id="action_caryvil_sales_dashboard" model="ir.actions.client">
            <field name="name">Dashboard de Ventas</field>
            <field name="tag">caryvil_sales_dashboard</field>
            <field name="target">current</field>
        </record>

        <!-- ================================================================ -->
        <!-- Vista Formulario de Soporte Técnico para caryvil.dashboard.sales -->
        <!-- ================================================================ -->
        <record id="view_caryvil_dashboard_sales_form" model="ir.ui.view">
            <field name="name">caryvil.dashboard.sales.form</field>
            <field name="model">caryvil.dashboard.sales</field>
            <field name="arch" type="xml">
                <form string="Dashboard de Ventas Caryvil" create="false" edit="false" delete="false">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group col="4">
                            <field name="total_sales_today" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="tx_count_today"/>
                            <field name="avg_ticket" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="sales_this_month" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="sales_last_month" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="growth_rate_month"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
