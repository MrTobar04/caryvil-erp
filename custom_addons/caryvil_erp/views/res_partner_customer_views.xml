<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View Extension for res.partner (Pharmacy Customers) -->
        <record id="view_partner_form_inherit_caryvil" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.caryvil</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='category_id']" position="after">
                    <field name="is_pharmacy_customer"/>
                </xpath>
                <xpath expr="//sheet/group" position="before">
                    <group string="Información de Cliente Salvador (DUI)" invisible="not is_pharmacy_customer">
                        <group>
                            <field name="first_name" placeholder="Nombres del cliente"/>
                            <field name="last_name" placeholder="Apellidos del cliente"/>
                        </group>
                        <group>
                            <field name="dui" placeholder="00000000-0"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>

        <!-- Search View Extension for res.partner (Pharmacy Customers) -->
        <record id="view_res_partner_filter_inherit_caryvil" model="ir.ui.view">
            <field name="name">res.partner.select.inherit.caryvil</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_res_partner_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="dui" string="DUI"/>
                </xpath>
                <xpath expr="//filter[@name='customer']" position="after">
                    <filter string="Clientes de Farmacia" name="pharmacy_customer" domain="[('is_pharmacy_customer', '=', True)]"/>
                </xpath>
            </field>
        </record>

        <!-- Action for Pharmacy Customers -->
        <record id="action_caryvil_partner_customer" model="ir.actions.act_window">
            <field name="name">Directorio de Clientes</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="domain">[('is_pharmacy_customer', '=', True)]</field>
            <field name="context">{'default_is_pharmacy_customer': True}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Registra un nuevo cliente de Farmacia Caryvil
                </p>
                <p>
                    Captura los datos del cliente incluyendo DUI salvadoreño, nombre, teléfono y dirección.
                </p>
            </field>
        </record>

        <!-- Submenu Item under Clientes -->
        <menuitem id="menu_caryvil_clientes_directorio"
                  name="Directorio de Clientes"
                  parent="caryvil_erp.menu_caryvil_clientes"
                  action="action_caryvil_partner_customer"
                  sequence="10"/>
    </data>
</odoo>
