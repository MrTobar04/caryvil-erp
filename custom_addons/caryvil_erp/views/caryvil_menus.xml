<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ================================================================ -->
        <!-- Menú Raíz de Farmacia Caryvil ERP                                -->
        <!-- ================================================================ -->
        <menuitem id="menu_caryvil_root"
                  name="Farmacia Caryvil"
                  web_icon="caryvil_erp,static/description/icon.png"
                  sequence="10"/>

        <!-- ================================================================ -->
        <!-- Menús de Primer Nivel                                            -->
        <!-- ================================================================ -->
        <menuitem id="menu_caryvil_dashboard"
                  name="Dashboard"
                  parent="menu_caryvil_root"
                  sequence="10"
                  action="action_caryvil_sales_dashboard"
                  groups="caryvil_erp.group_caryvil_inventory_purchases,caryvil_erp.group_caryvil_manager"/>

        <menuitem id="menu_caryvil_ventas"
                  name="Ventas y Caja"
                  parent="menu_caryvil_root"
                  sequence="20"
                  groups="caryvil_erp.group_caryvil_cashier,caryvil_erp.group_caryvil_manager"/>

        <menuitem id="menu_caryvil_inventario"
                  name="Medicamentos e Inventario"
                  parent="menu_caryvil_root"
                  sequence="30"
                  groups="caryvil_erp.group_caryvil_cashier,caryvil_erp.group_caryvil_inventory_purchases,caryvil_erp.group_caryvil_manager"/>

        <menuitem id="menu_caryvil_compras"
                  name="Compras y Proveedores"
                  parent="menu_caryvil_root"
                  sequence="40"
                  groups="caryvil_erp.group_caryvil_inventory_purchases,caryvil_erp.group_caryvil_manager"/>

        <menuitem id="menu_caryvil_clientes"
                  name="Clientes"
                  parent="menu_caryvil_root"
                  sequence="50"
                  groups="caryvil_erp.group_caryvil_cashier,caryvil_erp.group_caryvil_manager"/>

        <menuitem id="menu_caryvil_configuracion"
                  name="Configuración"
                  parent="menu_caryvil_root"
                  sequence="100"/>

        <!-- ================================================================ -->
        <!-- Acciones de Ventana y Submenús de Medicamentos e Inventario      -->
        <!-- ================================================================ -->
        <record id="action_caryvil_medicamentos" model="ir.actions.act_window">
            <field name="name">Medicamentos</field>
            <field name="res_model">product.template</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="domain">['|', ('therapeutic_category_id', '!=', False), ('active_ingredient_id', '!=', False)]</field>
            <field name="context">{'default_detailed_type': 'product'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Registra tu primer medicamento en el catálogo de Farmacia Caryvil
                </p>
            </field>
        </record>

        <menuitem id="menu_caryvil_medicamentos_catalogo"
                  name="Medicamentos"
                  parent="menu_caryvil_inventario"
                  action="action_caryvil_medicamentos"
                  sequence="10"/>

        <menuitem id="menu_caryvil_lotes_medicamentos"
                  name="Lotes y Caducidades"
                  parent="menu_caryvil_inventario"
                  action="stock.action_production_lot_form"
                  sequence="15"
                  groups="caryvil_erp.group_caryvil_inventory_purchases,caryvil_erp.group_caryvil_manager"/>

        <menuitem id="menu_caryvil_principios_activos"
                  name="Principios Activos"
                  parent="menu_caryvil_inventario"
                  action="action_caryvil_active_ingredient"
                  sequence="20"
                  groups="caryvil_erp.group_caryvil_cashier,caryvil_erp.group_caryvil_manager"/>

        <menuitem id="menu_caryvil_categorias_terapeuticas"
                  name="Categorías Terapéuticas"
                  parent="menu_caryvil_inventario"
                  action="action_caryvil_therapeutic_category"
                  sequence="30"
                  groups="caryvil_erp.group_caryvil_cashier,caryvil_erp.group_caryvil_manager"/>

        <menuitem id="menu_caryvil_reordering_rules"
                  name="Reglas de Reabastecimiento"
                  parent="menu_caryvil_inventario"
                  action="stock.action_orderpoint"
                  sequence="18"
                  groups="caryvil_erp.group_caryvil_inventory_purchases,caryvil_erp.group_caryvil_manager"/>

        <!-- Submenús de Configuración Farmacológica -->
        <menuitem id="menu_caryvil_config_farmacologia"
                  name="Catálogo Farmacológico"
                  parent="menu_caryvil_configuracion"
                  sequence="20"
                  groups="caryvil_erp.group_caryvil_manager"/>

        <menuitem id="menu_caryvil_config_active_ingredient"
                  name="Principios Activos"
                  parent="menu_caryvil_config_farmacologia"
                  action="action_caryvil_active_ingredient"
                  sequence="10"/>

        <menuitem id="menu_caryvil_config_therapeutic_category"
                  name="Categorías Terapéuticas"
                  parent="menu_caryvil_config_farmacologia"
                  action="action_caryvil_therapeutic_category"
                  sequence="20"/>

        <!-- ================================================================ -->
        <!-- Ocultamiento de Menús Raíz Nativos de Odoo (Modo Desarrollador)  -->
        <!-- Mantiene solo visible el menú unificado de Farmacia Caryvil      -->
        <!-- ================================================================ -->
        <record id="spreadsheet_dashboard.spreadsheet_dashboard_menu_root" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('base.group_no_one')])]"/>
        </record>

        <record id="sale.sale_menu_root" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('base.group_no_one')])]"/>
        </record>

        <record id="stock.menu_stock_root" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('base.group_no_one')])]"/>
        </record>

        <record id="purchase.menu_purchase_root" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('base.group_no_one')])]"/>
        </record>

        <record id="account.menu_finance" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('base.group_no_one')])]"/>
        </record>

        <record id="contacts.menu_contacts" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('base.group_no_one')])]"/>
        </record>

        <!-- ISSUE-66: se restringe a group_no_one (solo modo desarrollador) en vez -->
        <!-- de borrar el registro, para no dejar huérfanos sus submenús hijos.     -->
        <record id="menu_caryvil_configuracion" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('base.group_no_one')])]"/>
        </record>
    </data>
</odoo>

