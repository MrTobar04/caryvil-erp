<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>

        <record
            id="view_caryvil_account_move_invoice"
            model="ir.ui.view"
        >
            <field name="name">
                account.move.form.caryvil.invoice
            </field>

            <field name="model">account.move</field>

            <field
                name="inherit_id"
                ref="account.view_move_form"
            />

            <field name="arch" type="xml">

                <xpath
                    expr="//field[@name='invoice_date']"
                    position="after"
                >

                    <field
                        name="simple_invoice_number"
                        readonly="1"
                        invisible="move_type != 'out_invoice'"
                    />

                    <field
                        name="payment_method_display"
                        readonly="1"
                        invisible="move_type != 'out_invoice'"
                    />

                    <field
                        name="amount_in_words"
                        readonly="1"
                        invisible="move_type != 'out_invoice'"
                    />

                </xpath>

            </field>
        </record>

    </data>
</odoo>