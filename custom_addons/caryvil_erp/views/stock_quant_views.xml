<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_quant_inventory_adjustment_caryvil" model="ir.ui.view">
        <field name="name">stock.quant.inventory.adjustment.caryvil</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='inventory_diff_quantity']" position="after">
                <field name="adjustment_reason"
                       invisible="inventory_diff_quantity == 0"/>
                <field name="adjustment_notes"
                       invisible="inventory_diff_quantity == 0"/>
                <field name="counted_by_user_id"
                       readonly="1"/>
                <field name="validated_by_user_id"
                       readonly="1"/>
            </xpath>

            <xpath expr="//button[@name='action_apply_inventory']" position="attributes">
                <attribute name="groups">caryvil_erp.group_caryvil_manager</attribute>
                <attribute name="string">Aplicar Ajuste</attribute>
            </xpath>

        </field>
    </record>

</odoo>