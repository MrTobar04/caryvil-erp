<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================ -->
    <!-- Acción de Servidor para Ejecución Masiva del Reorden de Compras  -->
    <!-- SPEC-7.2.2: Escenario 2                                          -->
    <!-- ================================================================ -->
    <record id="action_server_calculate_replenishment_caryvil" model="ir.actions.server">
        <field name="name">Calcular Reorden de Compras</field>
        <field name="model_id" ref="stock.model_stock_warehouse_orderpoint"/>
        <field name="binding_model_id" ref="stock.model_stock_warehouse_orderpoint"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_calculate_replenishment_caryvil()</field>
        <field name="groups_id" eval="[(4, ref('caryvil_erp.group_caryvil_inventory_purchases'))]"/>
    </record>

    <!-- Formulario de Regla de Reabastecimiento -->
    <record id="view_stock_warehouse_orderpoint_form_caryvil" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.form.caryvil</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_calculate_replenishment_caryvil"
                            string="Calcular Reorden de Compras"
                            type="object"
                            class="oe_highlight"
                            groups="caryvil_erp.group_caryvil_inventory_purchases"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='product_max_qty']" position="after">
                <field name="qty_multiple"/>
                <field name="suggested_replenishment_qty" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Vista Árbol / Lista Editable de Reglas de Reabastecimiento -->
    <record id="view_stock_warehouse_orderpoint_tree_caryvil" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.tree.caryvil</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="decoration-warning">suggested_replenishment_qty &gt; 0</attribute>
            </xpath>
            <xpath expr="//tree" position="inside">
                <header>
                    <button name="action_calculate_replenishment_caryvil"
                            string="Calcular Reorden de Compras"
                            type="object"
                            class="btn-primary"
                            groups="caryvil_erp.group_caryvil_inventory_purchases"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='product_max_qty']" position="after">
                <field name="qty_multiple"/>
                <field name="suggested_replenishment_qty" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>