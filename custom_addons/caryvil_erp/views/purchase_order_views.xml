<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ================================================================ -->
        <!-- SECCIÓN 1: Extiende el formulario NATIVO de purchase.order con   -->
        <!-- los campos farmacéuticos de SPEC-8.1.1: Nombre Vendedor          -->
        <!-- (partner_id, nativo) + Proveedor (laboratory_id, derivado),      -->
        <!-- condiciones de pago y requerimientos de recepción. No reemplaza  -->
        <!-- la vista de Odoo, solo la extiende.                              -->
        <!-- ================================================================ -->

        <record id="view_purchase_order_form_caryvil" model="ir.ui.view">
            <field name="name">purchase.order.form.caryvil</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <!-- Se oculta el botón nativo "Crear Factura". Los abonos del día a día se   -->
                <!-- anotan en la pestaña "Abonos" (sin pasar por Contabilidad). Este botón    -->
                <!-- solo se habilita cuando ya se abonó el 100%, para generar de un clic la   -->
                <!-- Factura de Proveedor formal y su pago, ya reconciliado.                   -->
                <xpath expr="//button[@name='action_create_invoice']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <button name="action_create_invoice" position="after">
                    <button name="action_generar_factura_final_caryvil" type="object"
                            string="Generar Factura Final" class="oe_highlight"
                            invisible="state not in ('purchase', 'done') or abono_status_label != 'pagado' or payment_status_label == 'pagado'"/>
                </button>

                <div name="button_box" position="inside">
                    <button type="object" name="action_view_caryvil_payments"
                            class="oe_stat_button" icon="fa-money"
                            invisible="payment_count == 0">
                        <field name="payment_count" widget="statinfo" string="Pagos"/>
                    </button>
                </div>

                <field name="partner_id" position="attributes">
                    <attribute name="string">Nombre Vendedor</attribute>
                </field>
                <field name="partner_id" position="after">
                    <field name="laboratory_id" string="Proveedor" readonly="1"/>
                </field>
                <!-- "Vendor Reference" no aplica al flujo de Caryvil -->
                <field name="partner_ref" position="replace"/>
                <!-- "Fecha Prevista" se deja 100% nativa/intacta (sin ocultar ni vaciar). -->
                <div name="date_planned_div" position="after">
                    <field name="commercial_terms_id"/>
                </div>
                <page name="purchase_delivery_invoice" position="after">
                    <page string="Recepción" name="caryvil_reception">
                        <group>
                            <field name="notes_reception"/>
                        </group>
                    </page>
                    <page string="Abonos" name="caryvil_abonos">
                        <group>
                            <group>
                                <field name="monto_abonado" widget="monetary" readonly="1"/>
                                <field name="saldo_abonos_pendiente" widget="monetary" readonly="1"/>
                            </group>
                            <group>
                                <field name="abono_status_label" widget="badge"
                                       decoration-success="abono_status_label == 'pagado'"
                                       decoration-warning="abono_status_label == 'parcial'"
                                       decoration-danger="abono_status_label == 'pendiente'"/>
                            </group>
                        </group>
                        <field name="abono_ids">
                            <tree editable="bottom">
                                <field name="fecha"/>
                                <field name="monto" widget="monetary"/>
                                <field name="nota"/>
                                <field name="currency_id" column_invisible="True"/>
                            </tree>
                        </field>
                    </page>
                </page>

                <!-- Columnas de la tabla de productos en español -->
                <field name="product_id" position="attributes">
                    <attribute name="string">Producto</attribute>
                </field>
                <field name="name" position="attributes">
                    <attribute name="string">Descripción</attribute>
                </field>
                <field name="product_qty" position="attributes">
                    <attribute name="string">Cantidad</attribute>
                </field>
                <field name="price_unit" position="attributes">
                    <attribute name="string">Precio Unitario</attribute>
                </field>
                <field name="discount" position="attributes">
                    <attribute name="string">Descuento</attribute>
                </field>
                <field name="price_subtotal" position="attributes">
                    <attribute name="string">Subtotal</attribute>
                </field>
                <!-- Se oculta la columna de Impuestos por línea: el IVA (13%) se -->
                <!-- calcula una sola vez, en el resumen al final de la orden.    -->
                <field name="taxes_id" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </field>
                <field name="price_total" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </field>

                <!-- Resumen calculado en el navegador (JS), directo de las líneas ya          -->
                <!-- cargadas en pantalla — no depende de que el servidor recalcule el          -->
                <!-- encabezado a tiempo, así que Subtotal/Descuento/IVA/Total se ven correctos  -->
                <!-- desde el primer producto agregado, sin necesidad de tocar otro campo.       -->
                <field name="tax_totals" position="replace">
                    <field name="iva_percibido_check" invisible="1"/>
                    <field name="amount_total_final" widget="caryvil_purchase_live_totals" nolabel="1"/>
                </field>

                <!-- Abonos: estado de pago y saldo pendiente, tomados de las Facturas de -->
                <!-- Proveedor (Bills) y sus pagos nativos de Contabilidad.                -->
                <field name="invoice_status" position="after">
                    <field name="payment_status_label" widget="badge"
                           decoration-success="payment_status_label == 'pagado'"
                           decoration-warning="payment_status_label == 'parcial'"
                           decoration-danger="payment_status_label == 'pendiente'"
                           decoration-muted="payment_status_label == 'sin_facturar'"/>
                    <field name="amount_residual_total" widget="monetary"
                           invisible="payment_status_label in ('sin_facturar', 'pagado')"/>
                </field>
            </field>
        </record>

        <!-- ================================================================ -->
        <!-- SECCIÓN 2: LISTA de órdenes de compra, vista normal de Odoo       -->
        <!-- (Código PE0001, Nombre Vendedor, Proveedor, Total, Estado).      -->
        <!-- ================================================================ -->

        <record id="view_purchase_order_tree_caryvil" model="ir.ui.view">
            <field name="name">purchase.order.tree.caryvil</field>
            <field name="model">purchase.order</field>
            <field name="arch" type="xml">
                <tree string="Órdenes de Compra" decoration-muted="state_label == 'cancelado'">
                    <field name="name" string="Código"/>
                    <field name="date_order" string="Fecha de Orden"/>
                    <field name="partner_id" string="Nombre Vendedor"/>
                    <field name="laboratory_id" string="Proveedor"/>
                    <field name="amount_total" string="Total" widget="monetary"/>
                    <field name="saldo_abonos_pendiente" string="Saldo Pendiente" widget="monetary" optional="show"/>
                    <field name="currency_id" column_invisible="True"/>
                    <field name="state_label" string="Estado" widget="badge"
                           decoration-success="state_label == 'recibido'"
                           decoration-warning="state_label == 'pendiente'"
                           decoration-danger="state_label == 'cancelado'"/>
                    <field name="abono_status_label" string="Estado de Pago" widget="badge" optional="show"
                           decoration-success="abono_status_label == 'pagado'"
                           decoration-warning="abono_status_label == 'parcial'"
                           decoration-danger="abono_status_label == 'pendiente'"/>
                </tree>
            </field>
        </record>

        <!-- ================================================================ -->
        <!-- SECCIÓN 3: ACCIÓN de ventana y MENÚ dentro de "Compras y          -->
        <!-- Proveedores" (junto a Proveedores y Laboratorios).                -->
        <!-- ================================================================ -->

        <record id="action_purchase_order_caryvil" model="ir.actions.act_window">
            <field name="name">Órdenes de Compra</field>
            <field name="res_model">purchase.order</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="purchase.purchase_order_view_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crea tu primera orden de compra a un laboratorio o droguería
                </p>
            </field>
        </record>

        <record id="action_purchase_order_caryvil_view_tree" model="ir.actions.act_window.view">
            <field name="sequence">1</field>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_purchase_order_tree_caryvil"/>
            <field name="act_window_id" ref="action_purchase_order_caryvil"/>
        </record>

        <record id="action_purchase_order_caryvil_view_form" model="ir.actions.act_window.view">
            <field name="sequence">2</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="purchase.purchase_order_form"/>
            <field name="act_window_id" ref="action_purchase_order_caryvil"/>
        </record>

        <menuitem id="menu_caryvil_ordenes_compra"
                  name="Órdenes de Compra"
                  parent="menu_caryvil_compras"
                  action="action_purchase_order_caryvil"
                  groups="caryvil_erp.group_caryvil_inventory_purchases"
                  sequence="5"/>

    </data>
</odoo>
