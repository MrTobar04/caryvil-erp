[flake8]
# Configuración de Flake8 para Caryvil ERP (Odoo 17)
# Cumple con SPEC-1.3.1 §10 (Deliverables & Config as Code)

# Longitud máxima de línea estándar para Odoo y pantallas modernas
max-line-length = 120

# Complejidad ciclomática máxima permitida por función
max-complexity = 10

# Exclusiones de directorios que no deben ser analizados por flake8
exclude =
    .git,
    __pycache__,
    .venv,
    env,
    venv,
    build,
    dist,
    .pytest_cache,
    .agents,
    .vscode,
    infra/terraform,
    docs

# Ignorar reglas que entran en conflicto con formateadores modernos como Black
# E203: Espacio antes de ':' (conflicto con slicing de Black)
# W503: Salto de línea antes de operador binario (práctica recomendada por PEP8 moderno)
ignore =
    E203,
    W503

# Códigos de error y advertencias a reportar activamente
select =
    E,
    W,
    F,
    C

# Mostrar estadísticas y fragmentos de código en fallos
show-source = True
statistics = True
count = True
