# ==============================================================================
# FARMACIA CARYVIL ERP - VARIABLES DE ENTORNO (PLANTILLA)
# ==============================================================================
# Copia este archivo a `.env` y configura los valores correspondientes para tu
# entorno local o de despliegue. NUNCA subas el archivo `.env` real a Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONFIGURACIÓN DE BASE DE DATOS (POSTGRESQL)
# ------------------------------------------------------------------------------
# Nombre de la base de datos para Odoo
POSTGRES_DB=caryvil_dev

# Usuario administrador de la base de datos PostgreSQL
POSTGRES_USER=odoo

# Contraseña del usuario de base de datos (mínimo 16 caracteres en producción)
POSTGRES_PASSWORD=odoo_dev_password_2026

# Host de la base de datos ('db' en docker-compose, o host provisto por Render)
POSTGRES_HOST=db

# Puerto de conexión a PostgreSQL
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. CONFIGURACIÓN DEL SERVIDOR ODOO (ERP)
# ------------------------------------------------------------------------------
# Contraseña maestra de Odoo (Master Admin Password para crear/restaurar DBs)
ADMIN_PASSWORD=admin_caryvil_secret_2026

# Nombre de la base de datos que Odoo utilizará por defecto
DB_NAME=caryvil_dev
ODOO_DB_NAME=caryvil_dev

# Entorno de ejecución: 'dev', 'staging', 'production'
ODOO_STAGE=dev

# Habilitar proxy_mode (necesario detrás de Nginx, Traefik o el proxy de Render)
PROXY_MODE=True

# Puerto expuesto para el servicio web Odoo HTTP
ODOO_HTTP_PORT=8069

# Puerto expuesto para el servicio de Longpolling (Chat / Livechat / Bus)
ODOO_CHAT_PORT=8072

# ------------------------------------------------------------------------------
# 3. APROVISIONAMIENTO EN RENDER / TERRAFORM (INFRAESTRUCTURA CLOUD)
# ------------------------------------------------------------------------------
# Token de API generado en Render Dashboard (Account Settings -> API Keys)
RENDER_API_KEY=rnd_sample_api_token_value_xxxxxxxx

# Identificador de propietario en Render (User ID 'usr-...' o Team ID 'tea-...')
RENDER_OWNER_ID=usr_or_tea_sample_owner_id_xxxx

# Región geográfica de Render ('oregon', 'frankfurt', 'ohio', 'singapore')
RENDER_REGION=oregon

# Nombre del servicio en Render Cloud
RENDER_SERVICE_NAME=caryvil-erp
