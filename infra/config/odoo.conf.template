[options]
addons_path = /usr/lib/python3/dist-packages/odoo/addons,/mnt/extra-addons
data_dir = /var/lib/odoo
admin_passwd = $ADMIN_PASSWORD
db_host = $DB_HOST
db_port = $DB_PORT
db_user = $DB_USER
db_password = $DB_PASSWORD
db_name = $DB_NAME
dbfilter = ^$DB_NAME$
proxy_mode = True
list_db = True
workers = 0
max_cron_threads = 1
limit_time_cpu = 120
limit_time_real = 240
limit_memory_soft = 671088640
limit_memory_hard = 805306368
log_level = info
log_handler = :INFO
